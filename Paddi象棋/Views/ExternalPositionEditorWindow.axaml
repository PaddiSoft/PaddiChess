<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PaddiXiangqi" xmlns:external="using:PaddiXiangqi.External" xmlns:views="using:PaddiXiangqi.Views"
        x:Class="PaddiXiangqi.Views.ExternalPositionEditorWindow" x:Name="ExternalPositionEditor"
        Title="识别与摆棋 · 左侧原图 / 右侧棋盘" Width="1160" Height="880" MinWidth="860" MinHeight="700"
        RequestedThemeVariant="Light" WindowStartupLocation="CenterOwner" Background="#F5F7FB">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="16" RowSpacing="10">
    <TextBlock x:Name="ExternalEditorStatus" TextWrapping="Wrap" Foreground="#35445B"/>
    <WrapPanel Grid.Row="1" Orientation="Horizontal">
      <WrapPanel.Styles><Style Selector="Button"><Setter Property="Margin" Value="0,0,8,4"/><Setter Property="Padding" Value="10,7"/></Style></WrapPanel.Styles>
      <Button x:Name="ExternalEditorLocate" Content="自动重新定位"/>
      <Button x:Name="ExternalEditorManual" Content="两点重新定位"/>
      <Button x:Name="ExternalEditorRefresh" Content="刷新截图并识别"/>
      <Button x:Name="ExternalEditorFlip" Content="朝向：黑上红下 ↕"/>
      <Button x:Name="ExternalEditorOcr" Content="本地识字"/>
      <local:SafeComboBox x:Name="ExternalEditorTurn" Width="150" Margin="0,0,0,4"/>
    </WrapPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
      <external:CalibrationView x:Name="ExternalEditorCalibration" IsPicking="False"/>
      <TextBlock x:Name="ExternalEditorNoImage" Text="连接目标窗口后可在这里重新定位。" VerticalAlignment="Center"/>
      <Viewbox Grid.Column="1" Stretch="Uniform"><local:BoardView x:Name="ExternalEditorBoard" AnimationDurationMs="0"/></Viewbox>
    </Grid>
    <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="12" BorderBrush="#E0E7F0" BorderThickness="1">
      <Grid x:Name="ExternalEditorEditBar" ColumnDefinitions="Auto,*" ColumnSpacing="18">
        <views:PiecePaletteView x:Name="ExternalEditorPalette"/>
        <StackPanel Grid.Column="1" Spacing="8">
          <TextBlock Text="修正棋子" FontSize="14" FontWeight="SemiBold" Foreground="#26384C"/>
          <WrapPanel>
            <Button x:Name="ExternalEditorStandard" Content="标准开局" ToolTip.Tip="按当前朝向摆齐红黑 32 子，然后继续手动调整" Margin="0,0,6,4"/>
            <Button x:Name="ExternalEditorMove" Content="选择 / 移动" Margin="0,0,6,4"/>
            <Button x:Name="ExternalEditorErase" Content="擦除" Margin="0,0,6,4"/>
            <Button x:Name="ExternalEditorUndo" Content="撤销编辑" Margin="0,0,6,4"/>
            <Button x:Name="ExternalEditorClear" Content="清空棋盘" Margin="0,0,0,4"/>
          </WrapPanel>
          <TextBlock x:Name="ExternalEditorToolHint" TextWrapping="Wrap" FontSize="12" Foreground="#42618B"/>
          <TextBlock Text="数量为已摆 / 上限。先点棋子，再点目标位置移动；移到已有棋子上会替换它。"
                     TextWrapping="Wrap" FontSize="11" Foreground="#65748A"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <StackPanel Spacing="3" VerticalAlignment="Center">
        <TextBlock x:Name="ExternalEditorValidation" TextWrapping="Wrap" FontSize="12" Foreground="#A23840"/>
        <TextBlock Text="选择棋子栏后可连续放置，满额自动切回移动。" TextWrapping="Wrap" FontSize="11" Foreground="#65748A"/>
      </StackPanel>
      <Button x:Name="ExternalEditorCancel" Grid.Column="1" Content="取消" IsCancel="True"/>
      <Button x:Name="ExternalEditorAccept" Grid.Column="2" Content="采用局面并返回" Classes="primary"/>
    </Grid>
  </Grid>
</Window>
